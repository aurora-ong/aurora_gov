# ============================================================================
# AURORA DISCORD BOT
# ============================================================================
#
# Archivo de ejemplo para configurar la integración con Discord.
#
# 1. Crear una copia de este archivo llamandolo .env.discord
#
# 2. Completar en .env.discord las credenciales reales.

# Habilita o deshabilita el bot.
DISCORD_BOT_ENABLED=false

# Token privado del bot obtenido desde Discord Developer Portal.
DISCORD_BOT_TOKEN=

# ID de la aplicación de Discord.
DISCORD_APPLICATION_ID=

# ID del servidor de Discord donde funcionará el bot.
DISCORD_GUILD_ID=