<div class="min-h-screen w-full overflow-x-hidden bg-slate-50 text-slate-900">

  <%!-- HEADER --%>

  <header class="
    sticky top-0 z-40
    border-b border-slate-200
    bg-white/95 backdrop-blur
  ">
    <div class="
      mx-auto flex w-full max-w-7xl
      items-center justify-between
      gap-3 px-4 py-3
      sm:px-6 sm:py-4
      lg:px-8
    ">
      <div class="min-w-0">
        <p class="truncate text-base font-bold text-slate-950 sm:text-xl">
          AuroraGov
        </p>

        <p class="truncate text-xs text-slate-500 sm:text-sm">
          Prueba BETA
        </p>
      </div>

      <div class="shrink-0 text-right">
        <p class="
          hidden text-xs font-semibold uppercase
          tracking-wider text-slate-400
          sm:block
        ">
          Recorrido guiado
        </p>

        <p class="text-xs font-semibold text-slate-700 sm:text-sm">
          {@step + 1} / {@total_steps}
        </p>
      </div>
    </div>

    <.beta_progress
      step={@step}
      total_steps={@total_steps}
    />
  </header>

  <main class="
    mx-auto w-full max-w-7xl
    px-4 py-6
    sm:px-6 sm:py-8
    lg:px-8 lg:py-10
  ">

    <%!-- ================================================================ --%>
    <%!-- PRESENTACIÓN                                                     --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :intro do %>
      <section class="
        grid min-h-[68vh] items-center gap-8
        lg:grid-cols-2 lg:gap-14
      ">
        <div>
          <span class="
            inline-flex rounded-full bg-orange-100
            px-3 py-1.5 text-xs font-bold uppercase
            tracking-wider text-orange-600
          ">
            {@slide.section}
          </span>

          <h1 class="
            mt-5 text-3xl font-bold leading-tight
            text-slate-950
            sm:text-4xl lg:text-5xl
          ">
            {@slide.title}
          </h1>

          <p class="
            mt-5 text-lg font-medium text-slate-500
            sm:text-xl
          ">
            {@slide.subtitle}
          </p>

          <div class="mt-7 flex flex-wrap gap-2">
            <%= for chip <- @slide.chips do %>
              <.beta_chip label={chip} />
            <% end %>
          </div>
        </div>

        <div class="
          rounded-3xl border border-slate-200
          bg-white p-6 shadow-sm
          sm:p-8
        ">
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl bg-slate-50 p-5 text-center">
              <div class="text-3xl">👀</div>
              <p class="mt-3 font-bold">Conocer</p>
            </div>

            <div class="rounded-2xl bg-slate-50 p-5 text-center">
              <div class="text-3xl">🗳️</div>
              <p class="mt-3 font-bold">Participar</p>
            </div>

            <div class="rounded-2xl bg-slate-50 p-5 text-center">
              <div class="text-3xl">💬</div>
              <p class="mt-3 font-bold">Evaluar</p>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <%!-- ================================================================ --%>
    <%!-- OBJETIVO                                                         --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :objective do %>
      <section class="mx-auto max-w-5xl py-6 text-center sm:py-10">
        <span class="
          inline-flex rounded-full bg-orange-100
          px-3 py-1.5 text-xs font-bold uppercase
          tracking-wider text-orange-600
        ">
          {@slide.section}
        </span>

        <h1 class="
          mt-5 text-3xl font-bold text-slate-950
          sm:text-4xl lg:text-5xl
        ">
          {@slide.title}
        </h1>

        <p class="mt-4 text-base text-slate-500 sm:text-lg">
          {@slide.subtitle}
        </p>

        <div class="
          mt-8 grid gap-4
          sm:grid-cols-3
        ">
          <%= for {title, description} <- @slide.cards do %>
            <div class="
              rounded-2xl border border-slate-200
              bg-white p-6 shadow-sm
            ">
              <p class="text-xl font-bold text-slate-900">
                {title}
              </p>

              <p class="mt-2 text-sm text-slate-500">
                {description}
              </p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%!-- ================================================================ --%>
    <%!-- ORGANIZACIÓN A                                                   --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :principles do %>
      <section class="w-full">
        <div class="mx-auto max-w-4xl text-center">
          <span class="
            inline-flex rounded-full bg-blue-50
            px-3 py-1.5 text-xs font-bold uppercase
            tracking-wider text-blue-600
          ">
            {@slide.section}
          </span>

          <h1 class="
            mt-5 text-3xl font-bold text-slate-950
            sm:text-4xl lg:text-5xl
          ">
            {@slide.title}
          </h1>

          <p class="
            mx-auto mt-4 max-w-2xl
            text-base text-slate-500
            sm:text-lg
          ">
            {@slide.subtitle}
          </p>
        </div>

        <div class="
          mt-8 grid gap-4
          sm:grid-cols-2
          lg:grid-cols-4
        ">
          <%= for {title, description} <- @slide.principles do %>
            <.beta_principle
              title={title}
              description={description}
            />
          <% end %>
        </div>

        <div class="mt-7 text-center">
          <a
            href="https://aurora.ong/a"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-blue-600 hover:underline"
          >
            aurora.ong/a ↗
          </a>
        </div>
      </section>
    <% end %>

    <%!-- ================================================================ --%>
    <%!-- PANTALLAS DE LA APLICACIÓN                                      --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :screen do %>
      <section class="
        grid gap-7
        lg:grid-cols-[0.62fr_1.38fr]
        lg:items-center
        lg:gap-10
      ">
        <%!-- TEXTO --%>

        <div class="min-w-0">
          <span class="
            inline-flex rounded-full bg-orange-100
            px-3 py-1.5 text-xs font-bold uppercase
            tracking-wider text-orange-600
          ">
            {@slide.section}
          </span>

          <h1 class="
            mt-5 text-3xl font-bold leading-tight
            text-slate-950
            sm:text-4xl lg:text-5xl
          ">
            {@slide.title}
          </h1>

          <p class="
            mt-4 text-base leading-7 text-slate-500
            sm:text-lg
          ">
            {@slide.subtitle}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <%= for chip <- @slide.chips do %>
              <.beta_chip label={chip} />
            <% end %>
          </div>

          <%= if Map.get(@slide, :highlight) do %>
            <div class="
              mt-6 rounded-2xl
              border border-orange-100
              bg-orange-50/70 p-4
            ">
              <p class="
                text-sm font-medium leading-6
                text-slate-700
              ">
                {@slide.highlight}
              </p>
            </div>
          <% end %>
        </div>

        <%!-- IMAGEN --%>

        <div class="min-w-0">
          <a
            href={@slide.image}
            target="_blank"
            class="block"
          >
            <div class="
              overflow-hidden rounded-2xl
              border border-slate-200
              bg-white shadow-lg
              sm:rounded-3xl
            ">
              <div class="
                flex items-center justify-between
                gap-3 border-b border-slate-200
                px-4 py-3
              ">
                <p class="truncate text-sm font-bold text-slate-700">
                  {@slide.title}
                </p>

                <span class="
                  shrink-0 rounded-full bg-orange-50
                  px-2.5 py-1
                  text-[10px] font-bold uppercase
                  text-orange-600
                ">
                  AuroraGov
                </span>
              </div>

              <div class="bg-slate-100 p-2 sm:p-4">
                <img
                  src={@slide.image}
                  alt={@slide.title}
                  class="
                    block h-auto max-h-[68vh]
                    w-full rounded-xl object-contain
                  "
                  loading="lazy"
                />
              </div>
            </div>
          </a>

          <p class="
            mt-2 text-center
            text-xs text-slate-400
          ">
            Tocá la imagen para verla completa
          </p>
        </div>
      </section>
    <% end %>

    <%!-- ================================================================ --%>
    <%!-- TRES POSTURAS                                                    --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :postures do %>
      <section class="w-full">
        <div class="mx-auto max-w-4xl text-center">
          <span class="
            inline-flex rounded-full bg-blue-50
            px-3 py-1.5 text-xs font-bold uppercase
            tracking-wider text-blue-600
          ">
            {@slide.section}
          </span>

          <h1 class="
            mt-5 text-3xl font-bold text-slate-950
            sm:text-4xl lg:text-5xl
          ">
            {@slide.title}
          </h1>

          <p class="
            mx-auto mt-4 max-w-2xl
            text-base text-slate-500
            sm:text-lg
          ">
            {@slide.subtitle}
          </p>
        </div>

        <div class="
          mt-8 grid gap-5
          md:grid-cols-3
        ">
          <%= for posture <- @slide.images do %>
            <article class="
              overflow-hidden rounded-2xl
              border border-slate-200
              bg-white shadow-sm
            ">
              <a
                href={posture.image}
                target="_blank"
                class="block bg-slate-100 p-3"
              >
                <img
                  src={posture.image}
                  alt={posture.title}
                  class="
                    mx-auto block h-auto
                    max-h-[440px] w-full
                    object-contain
                  "
                  loading="lazy"
                />
              </a>

              <div class="p-5">
                <div class="flex items-center justify-between gap-3">
                  <h2 class="text-lg font-bold text-slate-900">
                    {posture.title}
                  </h2>

                  <span class="
                    rounded-full bg-slate-100
                    px-3 py-1 font-mono
                    text-sm font-bold
                    text-slate-700
                  ">
                    {posture.value}
                  </span>
                </div>

                <p class="mt-2 text-sm leading-6 text-slate-500">
                  {posture.description}
                </p>
              </div>
            </article>
          <% end %>
        </div>

        <div class="
          mx-auto mt-6 max-w-3xl
          rounded-2xl border border-blue-100
          bg-blue-50/60 p-4 text-center
        ">
          <p class="text-sm font-medium leading-6 text-slate-700">
            Las posturas individuales contribuyen a formar el criterio colectivo
            utilizado para gobernar cada poder.
          </p>
        </div>
      </section>
    <% end %>

    <%!-- ================================================================ --%>
    <%!-- FINAL                                                            --%>
    <%!-- ================================================================ --%>

    <%= if @slide.type == :final do %>
      <section class="
        mx-auto flex min-h-[65vh]
        max-w-4xl items-center
      ">
        <div class="
          w-full rounded-3xl
          border border-slate-200
          bg-white p-6 text-center
          shadow-sm
          sm:p-10
        ">
          <span class="
            inline-flex rounded-full bg-emerald-50
            px-3 py-1.5 text-xs font-bold uppercase
            tracking-wider text-emerald-700
          ">
            {@slide.section}
          </span>

          <h1 class="
            mt-5 text-3xl font-bold text-slate-950
            sm:text-4xl
          ">
            {@slide.title}
          </h1>

          <p class="
            mt-3 text-base text-slate-500
            sm:text-lg
          ">
            {@slide.subtitle}
          </p>

          <div class="
            mx-auto mt-8 grid max-w-2xl
            gap-4 sm:grid-cols-2
          ">
            <div class="
              rounded-2xl border border-slate-200
              bg-slate-50 p-5
            ">
              <p class="
                text-xs font-bold uppercase
                tracking-wider text-slate-400
              ">
                Usuario
              </p>

              <p class="
                mt-2 break-all
                font-semibold text-slate-900
              ">
                tu-email@aurora.ong
              </p>
            </div>

            <div class="
              rounded-2xl border border-slate-200
              bg-slate-50 p-5
            ">
              <p class="
                text-xs font-bold uppercase
                tracking-wider text-slate-400
              ">
                Password
              </p>

              <p class="
                mt-2 font-mono
                text-xl font-bold
                text-slate-900
              ">
                123456
              </p>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap justify-center gap-2">
            <%= for chip <- @slide.chips do %>
              <.beta_chip label={chip} />
            <% end %>
          </div>

          <a
            href={~p"/persons/log_in"}
            class="
              mt-8 inline-flex min-h-12 w-full
              items-center justify-center gap-3
              rounded-xl bg-orange-500
              px-6 py-3 font-bold text-white
              shadow-sm transition
              hover:bg-orange-600
              sm:w-auto
            "
          >
            Comenzar prueba BETA →
          </a>
        </div>
      </section>
    <% end %>

    <%!-- NAVEGACIÓN --%>

    <.beta_navigation
      previous?={@step > 0}
      next?={@step < @total_steps - 1}
    />
  </main>
</div>