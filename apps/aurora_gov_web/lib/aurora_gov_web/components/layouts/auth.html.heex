<main class="w-full h-screen overflow-y-auto">
  <div id="flash-toast-info" phx-hook="FlashToast" data-kind="info" class="hidden">{Phoenix.Flash.get(@flash, :info)}</div>
  <div id="flash-toast-error" phx-hook="FlashToast" data-kind="error" class="hidden">{Phoenix.Flash.get(@flash, :error)}</div>

  {@inner_content}
</main>
